# ============================================================
#  autopilot.env — EJEMPLO. Lo normal es generarlo con /autopilot-init
#  desde el agente, en la carpeta del repo o del workspace.
#
#  Sin este archivo, la carpeta NO participa del autopilot.
# ============================================================

# --- Modo un repo (este archivo en la raiz del repo) ---
# La rama base NO se configura aqui: cada workitem (task-<n> / bug-<n>) nace de la
# rama base por defecto que Orca define para el repo (orca worktree create sin
# --base-branch). Si hay que cambiarla, se ajusta en Orca (registro del repo).
# Carpeta del board. Vacio = .workitems/ junto a este archivo.
WORKITEMS_DIR=

# --- Modo workspace (este archivo en la carpeta padre de varios repos) ---
# Los repos se registran en Orca (orca repo add) y cada rama nace de la base por
# defecto de su repo. Cada tarea del board dice su repo (repo: <carpeta>).
# REPO.Konectame_BackOffice=master

# --- Paralelismo ---
# false = 1 coder a la vez (defecto). true = hasta MAX_CODERS coders, cada uno con un workitem
# distinto en su propio worktree de Orca; dos workitems nunca tocan el mismo archivo a la vez.
PARALLEL=false
MAX_CODERS=2

# --- Ambiente seguro ---
# Tiempo maximo en segundos de lo que corre por aenv.sh (lo que se conecta a una BD/API).
COMMAND_TIMEOUT=900

# --- Auto-merge ---
# Con true, en cuanto le dices a /autopilot 'aprobá <clave>', el autopilot mergea su rama
# a la base del repo (solo local: nunca push ni borra ramas) y la tarea queda en done.
# Si el merge no entra limpio (conflicto), la base queda intacta y la tarea va a stopped/
# con el motivo. Con false (default) el merge lo haces vos al revisar.
AUTO_MERGE=false