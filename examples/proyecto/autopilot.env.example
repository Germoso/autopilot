# ============================================================
#  autopilot.env — EJEMPLO. Lo normal es generarlo con /autopilot-init
#  desde el agente, en la carpeta del repo o del workspace.
#
#  Sin este archivo, la carpeta NO participa del autopilot.
# ============================================================

# --- Modo un repo (este archivo en la raiz del repo) ---
# OBLIGATORIA. Rama desde la que se crea la rama de cada workitem (task-<n> / bug-<n>).
BASE_BRANCH=
# Vacio = la carpeta de este archivo.
REPO_PATH=

# --- Modo workspace (este archivo en la carpeta padre de varios repos) ---
# Una linea por repo: REPO.<carpeta>=<rama base>. Si hay alguna, BASE_BRANCH/REPO_PATH se ignoran.
# Cada tarea del board dice su repo (repo: <carpeta>) y su rama se crea dentro de ese repo.
# REPO.Konectame_App_Clientes=dev
# REPO.Konectame_BackOffice=master

# --- Ambos ---
# Carpeta del board. Vacio = .workitems/ junto a este archivo.
WORKITEMS_DIR=
POLL_INTERVAL=5

# --- Paralelismo ---
# false = 1 coder y 1 QA (y 1 E2E) a la vez (defecto). true = hasta MAX_CODERS, MAX_QA y MAX_E2E, cada uno con un
# workitem distinto, en su propia copia del repo; dos workitems nunca tocan el mismo archivo.
PARALLEL=false
MAX_CODERS=2
MAX_QA=2

# --- Vigilante ---
# Lo corre el watcher cada WATCHDOG_INTERVAL s (sin tokens): mata procesos huerfanos (de tareas que
# ya terminaron) y colgados (HUNG_MINUTES sin usar CPU); avisa de tareas sin actividad STALE_MINUTES.
# COMMAND_TIMEOUT: tiempo maximo en segundos de lo que corre por aenv.sh.
WATCHDOG=true
WATCHDOG_INTERVAL=60
HUNG_MINUTES=10
STALE_MINUTES=45
COMMAND_TIMEOUT=900

# --- Telegram ---
# Avisos (y comandos /estado, /reqa, /pausa... desde el chat). Bot propio del autopilot:
# wi.sh autopilot.env telegram-setup. ALERTS_ONLY=true: solo lo que necesita tu intervencion.
TELEGRAM=false
TELEGRAM_ALERTS_ONLY=false

# --- Pruebas E2E (agente e2e-tester, despues del QA) ---
# Antes de activar: e2e-setup.sh y las cuentas de prueba E2E_<ROL>_USER / E2E_<ROL>_PASSWORD en
# .env.autopilot.e2e junto a este archivo. Los backends usan su .env.autopilot (base de QA) o, si lo
# creas, un .env.autopilot.e2e en ese repo (otra base u otro PORT). Ver README.
E2E=false
MAX_E2E=1
E2E_COMMAND_TIMEOUT=2400
# E2E_CLIENTS.<backend>=<front>,<front>
# E2E_PLATFORMS.<front>=web,android
# E2E_API.<app-flutter>=lib/config/config.dart|^final baseUrl = .*;$|final baseUrl = "{API}";
# E2E_API.<front-web>=env:VITE_API_BASE_URL,VITE_WEBSOCKET_URL   (se apuntan al backend local)
# Internet abierto en navegador y emulador; se bloquean los servidores de produccion que el kit detecta
# en los .env y en el config de la app. Para bloquear otros a mano:
# E2E_BLOCK_HOSTS=api.midominio.com,pagos.midominio.com
