# ============================================================
#  autopilot.env — EJEMPLO. Copiar a la raiz del proyecto.
#
#  Copia este archivo a la RAIZ de cada proyecto que deba participar.
#  Sin este archivo, el proyecto NO participa.
#
#      cp ~/.config/opencode/skills/autopilot/plantilla.env \
#         /mi/proyecto/autopilot.env
#
#  No contiene secretos: se puede versionar.
# ============================================================

# --- Repositorio ---
# Vacio = la carpeta donde esta este archivo.
REPO_PATH=

# Rama desde la que se crea la rama de cada workitem (task-<n> / bug-<n>).
# Si no existe, las tareas pasan a stopped: no se inventa otra base.
BASE_BRANCH=base-branch

# --- Board ---
# Carpeta del tablero. Vacio = $REPO_PATH/.workitems
# Si queda dentro del repo DEBE estar en .gitignore (install.sh --init lo hace).
# Puede apuntar a un vault de Obsidian u otra carpeta. Relativo = relativo a este archivo.
WORKITEMS_DIR=

# --- Comportamiento ---
POLL_INTERVAL=5
