# ============================================================
#  azure-sync.env — EJEMPLO. Copiar y completar.
#
#  cp azure-sync.env.example azure-sync.env
#
#  Si este archivo existe, el proyecto importa de Azure DevOps.
#  Si no existe, no importa.
#
#  El PAT NO va aqui. Va en azure-sync.secrets.env (gitignored)
#  o en la variable de entorno AZURE_DEVOPS_PAT.
# ============================================================

# --- Azure DevOps ---
AZURE_ORG=tu-organizacion
AZURE_PROJECT=Tu_Proyecto
AZURE_ITERATION=Tu_Proyecto\Sprint Actual
AZURE_USER=tu-usuario@ejemplo.com

# --- Board de workitems ---
# Carpeta del board. Vacio = <carpeta de este archivo>/.workitems,
# que es el mismo default que usa autopilot.env. Si en autopilot.env
# pusiste otro WORKITEMS_DIR, pone aqui el mismo valor.
WORKITEMS_DIR=
