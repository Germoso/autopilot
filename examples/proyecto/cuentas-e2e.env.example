# cuentas-e2e.env — cuentas de prueba del agente E2E. Lo creas TU, junto a autopilot.env
# (nunca en autopilot.env: ese archivo lo leen los agentes y no lleva contrasenas).
# Nombre libre si empieza con E2E_ (mejor con el rol). Solo cuentas de QA que existan en la base
# que usa el E2E. Ningun agente lo edita ni escribe sus valores en reportes o capturas.
E2E_BO_ADMIN_USER=admin.e2e@example.com
E2E_BO_ADMIN_PASSWORD=...
E2E_CLIENTE_USER=cliente.e2e@example.com
E2E_CLIENTE_PASSWORD=...
