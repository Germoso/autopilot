# ============================================================
#  notion-autopilot.env — EJEMPLO. Copiar y completar.
#
#  cp notion-autopilot.env.example notion-autopilot.env
#
#  Si este archivo existe, el proyecto participa del sistema
#  autonomo. Si no existe, no participa.
# ============================================================

# --- Credenciales de Notion ---
# Token de integracion. Crear en https://www.notion.so/my-integrations
# El tablero y el log DEBEN estar compartidos con la integracion.
NOTION_TOKEN=ntn_REEMPLAZAR

# Base de datos del tablero de tareas (Autonomous Dev Board)
NOTION_DATABASE_ID=REEMPLAZAR

# Base de datos del log de actividad
NOTION_LOG_DB_ID=REEMPLAZAR

# --- Este repositorio ---
# IMPORTANTE: install.sh genera esta ruta automaticamente.
# Si lo editas a mano, debe ser ABSOLUTA.
REPO_PATH=/ruta/absoluta/a/este/proyecto
MAIN_BRANCH=master

# --- Comportamiento ---
POLL_INTERVAL=60
MAX_TASK_SECONDS=1800
OPENCODE_AGENT=build
