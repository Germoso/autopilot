# ============================================================
#  azure-sync.env — configuracion del importador de Azure DevOps
#
#  Copia este archivo a la RAIZ de cada proyecto que deba importar
#  tareas de Azure DevOps. Sin este archivo, el proyecto NO importa.
#
#      cp ~/.config/opencode/skills/azure-sync/plantilla.env \
#         /mi/proyecto/azure-sync.env
#
#  El PAT NO va aqui. Va en azure-sync.secrets.env (gitignored),
#  o en la variable de entorno AZURE_DEVOPS_PAT.
# ============================================================

# --- Azure DevOps ---
AZURE_ORG=codikasrl
AZURE_PROJECT=Konectame_App_Clientes
AZURE_ITERATION=Konectame_App_Clientes\Sprint Mejoras Septiembre 2026
AZURE_USER=sgermoso@codika.net

# --- Notion ---
# El token y la DB del tablero. Si el proyecto ya tiene
# notion-autopilot.env, estos son los mismos valores.
NOTION_TOKEN=ntn_TU_TOKEN_AQUI
NOTION_DATABASE_ID=TU_DATABASE_ID_DEL_TABLERO
NOTION_LOG_DB_ID=TU_DATABASE_ID_DEL_LOG

# --- Donde se guardan los .md de detalle (opcional) ---
WORKITEM_DIR=
