# ============================================================
#  notion-autopilot.env
#
#  Copia este archivo en la RAÍZ de cada proyecto que quiera
#  participar del sistema autonomo. Sin este archivo, el
#  proyecto NO participa y la skill no se usa.
#
#      cp ~/.config/opencode/skills/notion-autopilot/plantilla.env \
#         /mi/proyecto/notion-autopilot.env
# ============================================================

# --- Credenciales (comunes a todos los proyectos) ---
NOTION_TOKEN=ntn_TU_TOKEN_AQUI

# --- Tablero de tareas (uno por proyecto) ---
NOTION_DATABASE_ID=TU_DATABASE_ID_DEL_TABLERO

# --- Log de actividad (puede ser el mismo para todos) ---
NOTION_LOG_DB_ID=TU_DATABASE_ID_DEL_LOG

# --- Este repositorio ---
REPO_PATH=/ruta/absoluta/a/este/proyecto
MAIN_BRANCH=master

# --- Comportamiento ---
POLL_INTERVAL=60
MAX_TASK_SECONDS=1800
