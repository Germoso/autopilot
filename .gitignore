# ============================================================
#  NUNCA versionar secretos.
#
#  Los .env reales pueden contener tokens (bases de datos, integraciones).
#  Este patron los bloquea por si quedan sueltos en el arbol.
# ============================================================

# Cualquier .env real, en cualquier carpeta
*.env
*.secrets.env

# Los .example SI se versionan (son la plantilla de instalacion)
!*.env.example
!plantilla.env

# Secretos explicitos
azure-sync.secrets.env

# Estado de ejecucion
*.log
*.lock
state.json
ledger.json
__pycache__/
*.pyc
.workitems/

# Skills instaladas en el proyecto (npx skills add): locales, no se versionan
.agents/
skills-lock.json
