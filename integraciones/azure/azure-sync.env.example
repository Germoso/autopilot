# ============================================================
#  azure-sync.env — EJEMPLO. Copialo a la raiz del proyecto (junto a
#  autopilot.env) como azure-sync.env y completalo.
#
#  Sin este archivo, la carpeta no importa de Azure DevOps.
#  El PAT puede ir aca (AZURE_DEVOPS_PAT=) o, mas separado del repo, en azure-sync.secrets.env,
#  en la variable AZURE_DEVOPS_PAT o en el del MCP (~/.config/autopilot-kit/ado-mcp.secrets.env).
#  Prioridad: variable > este archivo > azure-sync.secrets.env > MCP. No lo commitees.
# ============================================================

# AZURE_DEVOPS_PAT=       # tu PAT de Azure DevOps (scope Work Items, Read & Write); opcional aca

AZURE_ORG=tu-organizacion

# Carpeta del board donde se importa. Vacio = la de autopilot.env (WORKITEMS_DIR, o .workitems/).
# Relativo = relativo a este archivo. --board <carpeta> en la linea de comandos la pisa.
BOARD_DIR=

# Carpetas con work items ya sincronizados que ya no estan en el board (archivados, cerrados...).
# El sync salta todo work item que tenga su <tipo>-<numero>*.md en alguna (busca en subcarpetas).
# Separadas por coma; relativo = relativo a este archivo. Si una no existe, el sync no corre.
IGNORE_DIRS=

# Sprint: ruta (Proyecto\Sprint X) o @current = sprint actual del equipo "<Proyecto> Team"
# (@current:<Equipo> para otro equipo).

# --- Modo un repo ---
AZURE_PROJECT=Tu_Proyecto
AZURE_ITERATION=@current

# --- Modo workspace: una fuente por repo, SYNC.<carpeta>=<proyecto>|<sprint> ---
# (si hay alguna, AZURE_PROJECT/AZURE_ITERATION se ignoran)
# SYNC.Konectame_App_Clientes=Konectame_App_Clientes|@current
# SYNC.Konectame_BackOffice=Konectame_BackOffice|@current
