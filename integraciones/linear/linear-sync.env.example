# ============================================================
#  linear-sync.env — EJEMPLO. Copialo a la raiz del proyecto (junto a
#  autopilot.env) como linear-sync.env y completalo.
#
#  Sin este archivo, la carpeta no importa de Linear.
#  La API key NO va aqui: linear-sync.secrets.env o la variable LINEAR_API_KEY.
# ============================================================

# La "key" corta del team en Linear (la que aparece en el identifier de sus
# issues, ej. "ENG" en ENG-123), no su nombre completo.
LINEAR_TEAM=ENG

# Solo si el board es un workspace (varios repos, BASE_BRANCH por repo en
# autopilot.env): a que repo van las tareas de este team.
# LINEAR_REPO=Konectame_App_Clientes
