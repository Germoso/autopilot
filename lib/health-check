#!/usr/bin/env bash
# health-check — que falta para que las pruebas E2E funcionen, ANTES de correrlas
#   health-check                  todo el proyecto
#   health-check bug-37269        lo que piden los casos de esa tarea (o smoke, o --all)
#   health-check --android|--web  solo esa plataforma          health-check --deep   ademas arranca emulador y Chromium
# Busca autopilot.env en la carpeta actual o la de arriba (o usa AUTOPILOT_ENV).
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ENV_FILE="${AUTOPILOT_ENV:-}"
if [[ -z "$ENV_FILE" ]]; then
  for d in "$PWD" "$(dirname "$PWD")"; do [[ -f "$d/autopilot.env" ]] && { ENV_FILE="$d/autopilot.env"; break; }; done
fi
[[ -z "$ENV_FILE" ]] && { echo "health-check: no encuentro autopilot.env aqui ni en la carpeta de arriba (o define AUTOPILOT_ENV)" >&2; exit 2; }
exec python3 "$DIR/salud.py" "$ENV_FILE" "$@"
